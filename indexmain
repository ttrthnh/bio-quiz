let currentPart=0;
let partOrders=[];
let order=[],idx=0,score=0,done=0,locked=false;
function shuffleArray(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
const $=id=>document.getElementById(id);
function buildParts(){
  const count=Math.ceil(questions.length/PART_SIZE);
  partOrders=[];
  for(let p=0;p<count;p++){
    const start=p*PART_SIZE;
    const end=Math.min(start+PART_SIZE,questions.length);
    partOrders.push(Array.from({length:end-start},(_,i)=>start+i));
  }
}
function renderPartButtons(){
  const panel=$('partPanel');
  panel.innerHTML='';
  partOrders.forEach((arr,p)=>{
    const b=document.createElement('button');
    b.className='part-btn'+(p===currentPart?' active':'');
    const start=p*PART_SIZE+1, end=Math.min((p+1)*PART_SIZE,questions.length);
    b.textContent=`Part ${p+1}: ${start}-${end}`;
    b.onclick=()=>selectPart(p,false);
    panel.appendChild(b);
  });
}
function resetStats(){idx=0;score=0;done=0;$('score').textContent=0;$('done').textContent=0;}
function selectPart(p,shuffle=true){
  currentPart=p;
  order=[...partOrders[currentPart]];
  if(shuffle) shuffleArray(order);
  resetStats();
  renderPartButtons();
  render();
}
function render(){
  locked=false;
  const q=questions[order[idx]];
  const partStart=currentPart*PART_SIZE+1;
  const partEnd=Math.min((currentPart+1)*PART_SIZE,questions.length);
  $('partLabel').textContent=`Đang học Part ${currentPart+1} (${partStart}-${partEnd}) • ${order.length} câu`;
  $('qnum').textContent=`Question ${idx+1} / ${order.length}`;
  $('bar').style.width=(idx/order.length*100)+'%';
  $('prompt').textContent=q.prompt;
  $('feedback').className='feedback';
  $('options').innerHTML='';
  q.options.forEach((op,i)=>{const b=document.createElement('button');b.className='opt';b.innerHTML=`<b>${String.fromCharCode(65+i)}.</b> ${op}`;b.onclick=()=>choose(i,b);$('options').appendChild(b)});
  $('note').textContent=q.verified?'':'Note: câu này answer key được đoán theo keyword vì file gốc không đánh dấu đáp án.'
}
function choose(i,btn){
  if(locked)return;
  locked=true;
  const q=questions[order[idx]],buttons=[...document.querySelectorAll('.opt')];
  buttons[q.answer].classList.add('correct');
  const good=i===q.answer;
  if(!good)btn.classList.add('wrong');
  if(good)score++;
  done++;
  $('score').textContent=score;
  $('done').textContent=done;
  $('fbTitle').textContent=good?'Đúng rồi bà slayyy ✅':'Sai xíu thui bà 😭';
  $('answerText').innerHTML=`Đáp án đúng: <b>${String.fromCharCode(65+q.answer)}. ${q.options[q.answer]}</b>`;
  $('tip').textContent=q.tip;
  $('feedback').className='feedback show';
  $('bar').style.width=((idx+1)/order.length*100)+'%'
}
$('next').onclick=()=>{idx=(idx+1)%order.length;render()};
$('shuffle').onclick=()=>selectPart(currentPart,true);
$('restart').onclick=()=>selectPart(currentPart,false);
buildParts();
selectPart(0,true);
render();</script></body></html>
